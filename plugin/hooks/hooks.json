{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://localhost:${MCP_VOICE_HOOKS_PORT:-5111}/api/hooks/stop\" -H \"X-Session-Id: ${MCP_VOICE_SESSION_ID:-$(cat /tmp/mcp-voice-session-$PPID 2>/dev/null)}\" -H \"X-Caller-PPID: $PPID\" || echo '{}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "_voice-hooks__speak$",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://localhost:${MCP_VOICE_HOOKS_PORT:-5111}/api/hooks/pre-speak\" -H \"X-Session-Id: ${MCP_VOICE_SESSION_ID:-$(cat /tmp/mcp-voice-session-$PPID 2>/dev/null)}\" -H \"X-Caller-PPID: $PPID\" || echo '{}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!.*_voice-hooks__)",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://localhost:${MCP_VOICE_HOOKS_PORT:-5111}/api/hooks/post-tool\" -H \"X-Session-Id: ${MCP_VOICE_SESSION_ID:-$(cat /tmp/mcp-voice-session-$PPID 2>/dev/null)}\" -H \"X-Caller-PPID: $PPID\" || echo '{}'"
          }
        ]
      }
    ]
  }
}